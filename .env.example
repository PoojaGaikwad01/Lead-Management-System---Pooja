APP_NAME="Funky Monkey Leads"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Kolkata

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_IN

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# PostgreSQL / Supabase session pooler (port 5432). URL-encode special characters in the password (@ -> %40).
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require
# ...or individual settings (used when DATABASE_URL is empty, e.g. on Render — no URL-encoding needed):
# DB_HOST=
# DB_PORT=5432
# DB_DATABASE=postgres
# DB_USERNAME=
# DB_PASSWORD=
# DB_SSLMODE=require
# Schema for this app's tables. Create it once before migrating: CREATE SCHEMA IF NOT EXISTS lms;
DB_SCHEMA=lms

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Funky Monkey Lead System (config/leads.php) ---
# mock = no real Meta/WhatsApp/FCM/AI calls; live = real APIs
APP_MODE=mock

META_GRAPH_VERSION=v21.0
META_APP_SECRET=
META_VERIFY_TOKEN=
META_PAGE_ACCESS_TOKEN=
IG_ACCOUNT_ID=
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
# Google Ads lead forms: same value as "Key" in Google Ads → lead form → Webhook integration (URL: /webhooks/google-leads).
GOOGLE_LEAD_KEY=
# Admin "Send sample Google lead" button + "Clear samples". Default: on only when APP_MODE=mock.
# GOOGLE_DEMO_TOOLS=true
# Comma-separated WhatsApp numbers of agencies. 919900000001 is the mock agency used by tests/fixtures/meta — replace in production.
AGENCY_NUMBERS=919900000001

# AI parsing is optional; none = skip
AI_PROVIDER=none
AI_API_KEY=
AI_MODEL=

# Optional: path to Firebase service-account JSON; empty = in-app bell only
FIREBASE_CREDENTIALS_PATH=
REMINDER_AFTER_MINUTES=60
# Meta webhook log (object + message ids only). Default storage/logs/meta.log; Docker uses php://stderr
# LOG_META_PATH=
DEDUPE_DAYS=7
